<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="my_agv">

    <xacro:macro name="box_inertia" params="m w h d">
        <inertial>
            <mass value="${m}"/>
            <inertia ixx="${(m/12) * (h*h + d*d)}" ixy="0.0" ixz="0.0" iyy="${(m/12) * (w*w + d*d)}" iyz="0.0" izz="${(m/12) * (w*w + h*h)}"/>
        </inertial>
    </xacro:macro>

    <xacro:macro name="cylinder_inertia" params="m r h">
        <inertial>
            <mass value="${m}"/>
            <inertia ixx="${(m/12) * (3*r*r + h*h)}" ixy="0" ixz="0" iyy="${(m/12) * (3*r*r + h*h)}" iyz="0" izz="${(m/2) * (r*r)}"/>
        </inertial>
    </xacro:macro>

    <xacro:macro name="sphere_inertia" params="m r">
        <inertial>
            <mass value="${m}"/>
            <inertia ixx="${(2/5) * m * (r*r)}" ixy="0.0" ixz="0.0" iyy="${(2/5) * m * (r*r)}" iyz="0.0" izz="${(2/5) * m * (r*r)}"/>
        </inertial>
    </xacro:macro>

    <link name="base_footprint"/>
    
    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 0.09" rpy="0 0 0"/>
    </joint>
    
    <link name="base_link">
        <visual>
            <geometry><box size="0.3 0.22 0.1"/></geometry>
            <material name="blue"><color rgba="0 0 1 1"/></material>
        </visual>
        <collision>
            <geometry><box size="0.3 0.22 0.1"/></geometry>
        </collision>
        <xacro:box_inertia m="1.0" w="0.3" h="0.22" d="0.1"/>
    </link>
    
    <link name="imu_link">
        <inertial>
            <mass value="0.001"/>
            <inertia ixx="1.0e-6" ixy="0.0" ixz="0.0" iyy="1.0e-6" iyz="0.0" izz="1.0e-6"/>
        </inertial>
    </link>

    <joint name="imu_joint" type="fixed">
        <parent link="base_link"/>
        <child link="imu_link"/>
        <origin xyz="0.0 0.0 0.06" rpy="0 0 0"/>
    </joint>

    <link name="left_wheel">
        <visual>
            <geometry><cylinder radius="0.04" length="0.04"/></geometry>
            <material name="black"><color rgba="0 0 0 1"/></material>
        </visual>
        <collision>
            <geometry><cylinder radius="0.04" length="0.04"/></geometry>
        </collision>
        <xacro:cylinder_inertia m="0.25" r="0.04" h="0.04"/>
    </link>
    <joint name="left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel"/>
        <origin xyz="-0.08 0.125 -0.05" rpy="1.5708 0 0"/>
        <axis xyz="0 0 -1"/>
    </joint>

    <link name="right_wheel">
        <visual>
            <geometry><cylinder radius="0.04" length="0.04"/></geometry>
            <material name="black"><color rgba="0 0 0 1"/></material>
        </visual>
        <collision>
            <geometry><cylinder radius="0.04" length="0.04"/></geometry>
        </collision>
        <xacro:cylinder_inertia m="0.25" r="0.04" h="0.04"/>
    </link>
    <joint name="right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel"/>
        <origin xyz="-0.08 -0.125 -0.05" rpy="1.5708 0 0"/>
        <axis xyz="0 0 -1"/>
    </joint>

    <link name="caster_wheel">
        <visual>
            <geometry><sphere radius="0.02"/></geometry>
            <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
        </visual>
        <collision>
            <geometry><sphere radius="0.02"/></geometry>
        </collision>
        <xacro:sphere_inertia m="0.1" r="0.02"/>
    </link>
    <joint name="caster_joint" type="fixed">
        <parent link="base_link"/>
        <child link="caster_wheel"/>
        <origin xyz="0.1 0 -0.07" rpy="0 0 0"/>
    </joint>

    <link name="lidar_link">
        <visual>
            <geometry><cylinder radius="0.04" length="0.05"/></geometry>
            <material name="red"><color rgba="1 0 0 1"/></material>
        </visual>
        <collision>
            <geometry><cylinder radius="0.04" length="0.05"/></geometry>
        </collision>
        <xacro:cylinder_inertia m="0.1" r="0.04" h="0.05"/>
    </link>
    
    <joint name="lidar_joint" type="revolute">
        <parent link="base_link"/>
        <child link="lidar_link"/>
        <origin xyz="0.08 0 0.075" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit effort="0" velocity="0" lower="0" upper="0"/> 
    </joint>

    <!-- ======================================================= -->
    <!--                   CAMERA DEFINITION                     -->
    <!-- ======================================================= -->
    <link name="camera_link">
        <visual>
            <geometry><box size="0.03 0.08 0.03"/></geometry>
            <material name="green"><color rgba="0 1 0 1"/></material>
        </visual>
        <collision>
            <geometry><box size="0.03 0.08 0.03"/></geometry>
        </collision>
        <xacro:box_inertia m="0.05" w="0.03" h="0.08" d="0.03"/>
    </link>

    <joint name="camera_joint" type="fixed">
        <parent link="base_link"/>
        <child link="camera_link"/>
        <!-- Đặt camera phía trước base_link, nhô ra ngoài một chút -->
        <origin xyz="0.14 0 0.05" rpy="0 0 0"/>
    </joint>

    <!-- Joint và Link phụ để chuyển đổi hệ tọa độ sang chuẩn Camera Optical (Z hướng tới, X sang phải, Y hướng xuống) -->
    <link name="camera_link_optical"/>
    <joint name="camera_optical_joint" type="fixed">
        <parent link="camera_link"/>
        <child link="camera_link_optical"/>
        <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
    </joint>

    <!-- ======================================================= -->
    <!--                   GAZEBO PLUGINS                        -->
    <!-- ======================================================= -->
    
    <!-- Gazebo Camera Plugin -->
    <gazebo reference="camera_link">
        <sensor name="camera" type="camera">
            <pose>0 0 0 0 0 0</pose>
            <always_on>true</always_on>
            <visualize>true</visualize>
            <update_rate>30</update_rate>
            <topic>camera/image_raw</topic>
            <gz_frame_id>camera_link_optical</gz_frame_id>
            <camera>
                <horizontal_fov>1.089</horizontal_fov> <!-- Góc mở khoảng 62.4 độ -->
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.05</near>
                    <far>8.0</far>
                </clip>
            </camera>
        </sensor>
    </gazebo>

    <gazebo reference="lidar_link">
        <sensor name="lidar" type="gpu_lidar"> 
            <pose>0 0 0 0 0 0</pose>
            <always_on>true</always_on>
            <visualize>true</visualize>
            <update_rate>10</update_rate>
            <topic>scan</topic> 
            <gz_frame_id>lidar_link</gz_frame_id> 
            <ray>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <resolution>1.0</resolution>
                        <min_angle>-3.14</min_angle>
                        <max_angle>3.14</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.12</min>
                    <max>10.0</max>
                    <resolution>0.01</resolution>
                </range>
            </ray>
        </sensor>
    </gazebo>

    <gazebo reference="imu_link">
        <preserveFixedJoint>true</preserveFixedJoint>
        <sensor name="imu_sensor" type="imu">
            <pose>0 0 0 0 0 0</pose>
            <always_on>true</always_on>
            <update_rate>30</update_rate>
            <topic>imu/data</topic> 
            <gz_frame_id>imu_link</gz_frame_id> 
            
            <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu">
            </plugin>
        </sensor>
    </gazebo>
    
    <gazebo>
        <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
            <left_joint>left_wheel_joint</left_joint>
            <right_joint>right_wheel_joint</right_joint>
            <wheel_separation>0.25</wheel_separation> 
            <wheel_radius>0.04</wheel_radius>     
            <odom_publish_frequency>30</odom_publish_frequency>
            <topic>/cmd_vel</topic>
            <odom_topic>/odom</odom_topic>
            
            <frame_id>odom</frame_id>
            <child_frame_id>base_footprint</child_frame_id> 
            <publish_odom_tf>false</publish_odom_tf>
            <publish_wheel_tf>false</publish_wheel_tf>
        </plugin>
    </gazebo>

    <gazebo>
        <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
            <joint_name>left_wheel_joint</joint_name>
            <joint_name>right_wheel_joint</joint_name>
            <joint_name>lidar_joint</joint_name>
            <topic>/joint_states</topic> 
        </plugin>
    </gazebo>

    <gazebo reference="caster_wheel">
        <mu1>0.0</mu1><mu2>0.0</mu2>
        <kp>1000000.0</kp><kd>100.0</kd>
    </gazebo>
    <gazebo reference="left_wheel">
        <mu1>1.5</mu1><mu2>1.5</mu2>
        <kp>1000000.0</kp><kd>100.0</kd>
    </gazebo>
    <gazebo reference="right_wheel">
        <mu1>1.5</mu1><mu2>1.5</mu2>
        <kp>1000000.0</kp><kd>100.0</kd>
    </gazebo>

</robot>